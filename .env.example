# Backend (docker-compose reescribe DB_URL a jdbc:postgresql://db:5432/$DB_NAME)
# DB_HOST_PORT es el puerto publicado en el host para el Postgres del contenedor.
# Por defecto 5433 (no 5432) para no chocar con un PostgreSQL local ya instalado.
DB_NAME=gymflow
DB_HOST_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/gymflow
DB_USERNAME=gymflow
DB_PASSWORD=gymflow

# Frontend (ver también frontend/.env.example)
VITE_API_URL=http://localhost:8080
